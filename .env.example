# Gemini API Key (Required)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-3.5-flash-lite)
# Supported options: gemini-3.5-flash-lite, gemini-3.8-flash, etc.
GEMINI_MODEL=gemini-3.5-flash-lite

# Microphone Device Index (Optional, integer index or leave empty for default)
# Run `python test_microphone.py` to see available input device indices
MIC_DEVICE_INDEX=
